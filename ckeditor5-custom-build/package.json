{
  "name": "ckeditor5-custom-build",
  "version": "1.0.0",
  "description": "Standalone custom build of CKEditor 5 for legacy Vue 2 and Webpack 4",
  "main": "dist/ckeditor.js",
  "style": "dist/ckeditor.css",
  "scripts": {
    "build": "vite build",
    "copy": "cmd /c copy-to-final-pack.bat --no-pause",
    "build:pack": "vite build && cmd /c copy-to-final-pack.bat --no-pause"
  },
  "keywords": [
    "ckeditor5",
    "ckeditor",
    "vue2",
    "webpack4",
    "custom-build"
  ],
  "author": "",
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "ckeditor5": "^48.5.0",
    "codemirror": "^6.0.2",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "vite": "^5.4.14"
  }
}
